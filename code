def main():
    parser = argparse.ArgumentParser(description="AI Recruiting Agent")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--candidate", type=str, help="Internal candidate id")
    parser.add_argument("--job", type=str, default="backend_engineer")
    parser.add_argument("--resume-file", type=str, help="Path to resume text file")
    parser.add_argument("--rank", action="store_true", help="Rank internal candidates for --job")
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()

    if args.check:
        notes = asyncio.run(self_check())
        print("PASS")
        for n in notes:
            print(n)
        return

    if args.serve:
        if not HAS_FASTAPI:
            raise SystemExit("Install fastapi uvicorn: pip install fastapi uvicorn")
        import uvicorn

        uvicorn.run(app, host=args.host, port=args.port)
        return

    agent = RecruitingAgent()

    if args.rank:
        result = asyncio.run(agent.rank_for_job(args.job))
        print(json.dumps(result, indent=2))
        return

    resume_text = None
    if args.resume_file:
        with open(args.resume_file, encoding="utf-8") as f:
            resume_text = f.read()

    if not args.candidate and not resume_text:
        # demo
        args.candidate = "cand_001"

    result = asyncio.run(
        agent.evaluate(
            resume_text=resume_text,
            candidate_id=args.candidate,
            job_id=args.job,
        )
    )
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
