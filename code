def score_candidate_against_job(profile: dict, job: dict) -> dict:
    req = [s.lower() for s in job["required_skills"]]
    pref = [s.lower() for s in job["preferred_skills"]]
    cand_skills = {s.lower() for s in profile.get("skills") or []}

    req_hit = [s for s in req if s in cand_skills]
    pref_hit = [s for s in pref if s in cand_skills]
    req_miss = [s for s in req if s not in cand_skills]

    skill_score = 0.0
    if req:
        skill_score = 0.7 * (len(req_hit) / len(req)) + 0.3 * (
            len(pref_hit) / max(1, len(pref))
        )
    skill_score = round(min(1.0, skill_score) * 100, 1)

    years = float(profile.get("years_experience") or 0)
    min_y = float(job.get("min_years") or 0)
    if min_y <= 0:
        exp_score = 80.0
    elif years >= min_y:
        exp_score = min(100.0, 70 + (years - min_y) * 6)
    else:
        exp_score = max(20.0, 70 * (years / min_y))
    exp_score = round(exp_score, 1)

    edu_text = (profile.get("education") or "").lower()
    edu_ok = any(e in edu_text for e in job.get("education") or [])
    edu_score = 90.0 if edu_ok else (55.0 if edu_text else 40.0)

    overall = round(0.55 * skill_score + 0.30 * exp_score + 0.15 * edu_score, 1)

    if overall >= 80 and not req_miss:
        recommendation = "advance"
        next_actions = [
            "Schedule a technical screen",
            "Share the role scorecard with the hiring manager",
        ]
    elif overall >= 65 and len(req_miss) <= 2:
        recommendation = "consider"
        next_actions = [
            "Request a skills clarification on: " + ", ".join(req_miss or ["open gaps"]),
            "Optional take-home aligned to missing required skills",
        ]
    else:
        recommendation = "pass"
        next_actions = [
            "Archive with polite decline",
            "Tag profile for future roles matching current skills",
        ]

    reasoning_parts = [
        f"Matched {len(req_hit)}/{len(req)} required skills"
        + (f" ({', '.join(req_hit)})" if req_hit else ""),
        f"Experience {years}y vs role minimum {min_y}y",
        "Education aligns with role expectations"
        if edu_ok
        else "Education only partially matches role preferences",
    ]
    if req_miss:
        reasoning_parts.append("Missing required: " + ", ".join(req_miss))
    if pref_hit:
        reasoning_parts.append("Preferred skills present: " + ", ".join(pref_hit))

    return {
        "scores": {
            "skills": skill_score,
            "experience": exp_score,
            "education": edu_score,
            "overall": overall,
        },
        "matched_required": req_hit,
        "matched_preferred": pref_hit,
        "missing_required": req_miss,
        "recommendation": recommendation,
        "reasoning": strip_machine_labels("; ".join(reasoning_parts) + "."),
        "next_actions": next_actions,
    }


def candidate_summary(profile: dict, job: dict, evaluation: dict) -> str:
    name = profile.get("name") or "Candidate"
    role = job.get("title") or "the role"
    overall = evaluation["scores"]["overall"]
    rec = evaluation["recommendation"]
    skills = ", ".join((profile.get("skills") or [])[:6]) or "not listed"
    text = (
        f"{name} is evaluated for {role} with an overall fit of {overall}. "
        f"Recommendation: {rec}. "
        f"Highlighted skills: {skills}. "
        f"{evaluation['reasoning']}"
    )
    return strip_machine_labels(text)


