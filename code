SKILL_VOCAB = sorted(
    {
        s
        for job in JOBS.values()
        for s in job["required_skills"] + job["preferred_skills"]
    }
    | {
        "java",
        "go",
        "c++",
        "node.js",
        "django",
        "flask",
        "mongodb",
        "graphql",
        "spark",
        "airflow",
        "figma",
        "git",
