if HAS_FASTAPI:
    app = FastAPI(title="Recruiting Agent", version="1.0.0")
    _agent = RecruitingAgent()

    class EvaluateBody(BaseModel):
        resume_text: Optional[str] = None
        candidate_id: Optional[str] = None
        candidate_query: Optional[str] = None
        job_id: Optional[str] = None
        job_title: Optional[str] = None

    class RankBody(BaseModel):
        job_id: str
        limit: int = 5
        min_years: float = 0

    @app.get("/health")
    def health():
        return {
            "ok": True,
            "tools": [t["name"] for t in _agent.tool_schemas()],
            "jobs": _agent.list_jobs(),
        }

    @app.post("/evaluate")
    async def evaluate(body: EvaluateBody):
        result = await _agent.evaluate(
            resume_text=body.resume_text,
            candidate_id=body.candidate_id,
            candidate_query=body.candidate_query,
            job_id=body.job_id,
            job_title=body.job_title,
        )
        if result.get("status") == "error":
            raise HTTPException(status_code=400, detail=result.get("error"))
        return result

    @app.post("/rank")
    async def rank(body: RankBody):
        return await _agent.rank_for_job(body.job_id, body.limit, body.min_years)

    @app.get("/jobs")
    def jobs():
        return _agent.list_jobs()

    @app.get("/tools")
    def tools():
        return _agent.tool_schemas()


