@dataclass
class ToolSpec:
    name: str
    description: str
    parameters: dict
    handler: Callable[[dict], Any]


class RecruitingTools:
    def __init__(self):
        self.tools: dict[str, ToolSpec] = {}
        self._register()

    def _register(self):
        self.tools["parse_resume"] = ToolSpec(
            name="parse_resume",
            description="Parse resume text into name, email, skills, years, education, titles.",
            parameters={
                "type": "object",
                "properties": {"text": {"type": "string"}},
                "required": ["text"],
            },
            handler=lambda a: parse_resume_text(a["text"]),
        )
        self.tools["search_candidates"] = ToolSpec(
            name="search_candidates",
            description="Search the internal candidate database by skills, name, or free-text query.",
            parameters={
                "type": "object",
                "properties": {
                    "query": {"type": "string"},
                    "skill": {"type": "string"},
                    "min_years": {"type": "number"},
                    "limit": {"type": "integer", "default": 5},
                },
                "required": [],
            },
            handler=self._search_candidates,
        )
        self.tools["get_job_description"] = ToolSpec(
            name="get_job_description",
            description="Load a job description by role id or title keyword.",
            parameters={
                "type": "object",
                "properties": {
                    "job_id": {"type": "string"},
                    "title_query": {"type": "string"},
                },
                "required": [],
            },
            handler=self._get_job,
        )
        self.tools["score_match"] = ToolSpec(
            name="score_match",
            description="Score a candidate profile against a job description; returns scores and recommendation.",
            parameters={
                "type": "object",
                "properties": {
                    "profile": {"type": "object"},
                    "job_id": {"type": "string"},
                },
                "required": ["profile", "job_id"],
            },
            handler=self._score,
        )

    def _search_candidates(self, args: dict) -> list[dict]:
        query = (args.get("query") or "").lower().strip()
        skill = (args.get("skill") or "").lower()
        min_years = float(args.get("min_years") or 0)
        limit = int(args.get("limit") or 5)
        out = []
        for c in INTERNAL_CANDIDATES:
            if min_years and c["years"] < min_years:
                continue
            if skill and skill not in [s.lower() for s in c["skills"]]:
                continue
            # Exact id match
            if query and (query == c["id"].lower() or query == c["email"].lower()):
                out.append(self._public_candidate(c))
                continue
            blob = " ".join(
                [
                    c["id"],
                    c["name"],
                    c["email"],
                    c["summary"],
                    " ".join(c["skills"]),
                    " ".join(c["titles"]),
                ]
            ).lower()
            if query:
                toks = [t for t in query.split() if len(t) > 1]
                if toks and not any(tok in blob for tok in toks):
                    continue
            out.append(self._public_candidate(c))
        return out[:limit]

    @staticmethod
    def _public_candidate(c: dict) -> dict:
        return {
            "id": c["id"],
            "name": c["name"],
            "email": c["email"],
            "skills": c["skills"],
            "years": c["years"],
            "education": c["education"],
            "titles": c["titles"],
            "summary": c["summary"],
            "resume_text": c["resume_text"],
        }

    def _get_job(self, args: dict) -> dict:
        jid = (args.get("job_id") or "").lower().strip().replace(" ", "_")
        if jid in JOBS:
            return dict(JOBS[jid])
        tq = (args.get("title_query") or args.get("job_id") or "").lower()
        for job in JOBS.values():
            if tq and (tq in job["id"] or tq in job["title"].lower()):
                return dict(job)
        return {"error": "Job not found", "available": list(JOBS.keys())}

    def _score(self, args: dict) -> dict:
        job = self._get_job({"job_id": args.get("job_id", "")})
        if "error" in job:
            return job
        profile = args.get("profile") or {}
        return score_candidate_against_job(profile, job)

    def schemas(self) -> list[dict]:
        return [
            {"name": t.name, "description": t.description, "parameters": t.parameters}
            for t in self.tools.values()
        ]

    def call(self, name: str, arguments: dict) -> Any:
        if name not in self.tools:
            return {"error": f"Unknown tool: {name}"}
        try:
            return self.tools[name].handler(arguments or {})
        except Exception as err:  # noqa: BLE001
            return {"error": str(err)}


