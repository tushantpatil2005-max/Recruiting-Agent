@dataclass
class StepRecord:
    step: int
    thought: str
    action: str
    arguments: dict
    observation: Any
    latency_ms: float


class RecruitingAgent:
    def __init__(self, max_steps: int = MAX_STEPS):
        self.tools = RecruitingTools()
        self.max_steps = max_steps
        self.runs: dict[str, dict] = {}

    def tool_schemas(self) -> list[dict]:
        return self.tools.schemas()

    def list_jobs(self) -> list[dict]:
        return [
            {"id": j["id"], "title": j["title"], "level": j["level"], "location": j["location"]}
            for j in JOBS.values()
        ]

    async def evaluate(
        self,
        *,
        resume_text: Optional[str] = None,
        candidate_id: Optional[str] = None,
        candidate_query: Optional[str] = None,
        job_id: Optional[str] = None,
        job_title: Optional[str] = None,
    ) -> dict:
        """
        Evaluate one candidate against one job using tools.
        Provide either resume_text, candidate_id, or candidate_query.
        Provide job_id or job_title.
        """
        t0 = time.time()
        run_id = f"eval_{uuid.uuid4().hex[:8]}"
        steps: list[StepRecord] = []

        # Resolve job via tool
        steps.append(self._run_tool(
            len(steps),
            "Load the target job description so scoring uses role requirements.",
            "get_job_description",
            {"job_id": job_id or "", "title_query": job_title or job_id or ""},
        ))
        job_obs = steps[-1].observation
        if isinstance(job_obs, dict) and job_obs.get("error"):
            return self._error_result(run_id, t0, steps, f"Job not found: {job_id or job_title}")

        # Resolve candidate
        profile = None
        source = None
        if resume_text:
            steps.append(self._run_tool(
                len(steps),
                "Parse the submitted resume into structured fields.",
                "parse_resume",
                {"text": resume_text},
            ))
            profile = steps[-1].observation
            source = "resume_text"
        elif candidate_id or candidate_query:
            args = {"limit": 5}
            if candidate_id:
                args["query"] = candidate_id
            if candidate_query:
                args["query"] = candidate_query
            steps.append(self._run_tool(
                len(steps),
                "Search the internal candidate store for a matching profile.",
                "search_candidates",
                args,
            ))
            hits = steps[-1].observation or []
            if candidate_id:
                hits = [h for h in hits if h.get("id") == candidate_id] or hits
            if not hits:
                return self._error_result(run_id, t0, steps, "No internal candidate matched the query.")
            chosen = hits[0]
            source = "internal:" + chosen["id"]
            # Parse stored resume for consistent schema
            steps.append(self._run_tool(
                len(steps),
                "Parse the stored resume text for consistent extraction.",
                "parse_resume",
                {"text": chosen["resume_text"]},
            ))
            profile = steps[-1].observation
            # Prefer store years if parser under-reads
            if (profile.get("years_experience") or 0) < chosen.get("years", 0):
                profile["years_experience"] = chosen["years"]
            if not profile.get("name") or profile["name"] == "Unknown":
                profile["name"] = chosen["name"]
            if not profile.get("email"):
                profile["email"] = chosen.get("email", "")
        else:
            return self._error_result(
                run_id, t0, steps, "Provide resume_text, candidate_id, or candidate_query."
            )

        # Score via tool
        steps.append(self._run_tool(
            len(steps),
            "Score the candidate against required and preferred skills for the role.",
            "score_match",
            {"profile": profile, "job_id": job_obs["id"]},
        ))
        evaluation = steps[-1].observation
        if isinstance(evaluation, dict) and evaluation.get("error"):
            return self._error_result(run_id, t0, steps, evaluation["error"])

        summary = candidate_summary(profile, job_obs, evaluation)

        result = {
            "id": run_id,
            "status": "complete",
            "candidate": {
                "name": profile.get("name"),
                "email": profile.get("email"),
                "skills": profile.get("skills"),
                "years_experience": profile.get("years_experience"),
                "education": profile.get("education"),
                "titles": profile.get("titles"),
                "source": source,
            },
            "job": {
                "id": job_obs["id"],
                "title": job_obs["title"],
                "level": job_obs["level"],
                "location": job_obs["location"],
                "required_skills": job_obs["required_skills"],
                "preferred_skills": job_obs["preferred_skills"],
                "min_years": job_obs["min_years"],
            },
            "scores": evaluation["scores"],
            "matched_required": evaluation["matched_required"],
            "matched_preferred": evaluation["matched_preferred"],
            "missing_required": evaluation["missing_required"],
            "recommendation": evaluation["recommendation"],
            "reasoning": evaluation["reasoning"],
            "next_actions": evaluation["next_actions"],
            "summary": summary,
            "tools_used": sorted({s.action for s in steps}),
            "steps": [asdict(s) for s in steps],
            "timings": {
                "total_ms": round((time.time() - t0) * 1000, 2),
                "sla_ms": SLA_MS,
            },
        }
        self.runs[run_id] = result
        return result

    async def rank_for_job(
        self, job_id: str, limit: int = 5, min_years: float = 0
    ) -> dict:
        """Search internal candidates and score each against a job."""
        t0 = time.time()
        run_id = f"rank_{uuid.uuid4().hex[:8]}"
        steps: list[StepRecord] = []

        steps.append(self._run_tool(
            0,
            "Load job requirements for ranking.",
            "get_job_description",
            {"job_id": job_id},
        ))
        job = steps[-1].observation
        if isinstance(job, dict) and job.get("error"):
            return self._error_result(run_id, t0, steps, job["error"])

        steps.append(self._run_tool(
            1,
            "Pull internal candidates, optionally filtered by experience.",
            "search_candidates",
            {"query": "", "min_years": min_years, "limit": 20},
        ))
        hits = steps[-1].observation or []

        ranked = []
        for c in hits:
            profile = parse_resume_text(c["resume_text"])
            if (profile.get("years_experience") or 0) < c.get("years", 0):
                profile["years_experience"] = c["years"]
            profile["name"] = c["name"]
            profile["email"] = c.get("email", "")
            steps.append(self._run_tool(
                len(steps),
                f"Score {c['name']} for {job['title']}.",
                "score_match",
                {"profile": profile, "job_id": job["id"]},
            ))
            ev = steps[-1].observation
            ranked.append(
                {
                    "candidate_id": c["id"],
                    "name": c["name"],
                    "scores": ev["scores"],
                    "recommendation": ev["recommendation"],
                    "reasoning": ev["reasoning"],
                    "next_actions": ev["next_actions"],
                    "summary": candidate_summary(profile, job, ev),
                }
            )

        ranked.sort(key=lambda r: r["scores"]["overall"], reverse=True)
        ranked = ranked[:limit]

        return {
            "id": run_id,
            "status": "complete",
            "job": {"id": job["id"], "title": job["title"]},
            "candidates": ranked,
            "tools_used": sorted({s.action for s in steps}),
            "steps": [asdict(s) for s in steps],
            "timings": {
                "total_ms": round((time.time() - t0) * 1000, 2),
                "sla_ms": SLA_MS,
            },
        }

    def _run_tool(self, step: int, thought: str, action: str, arguments: dict) -> StepRecord:
        t0 = time.time()
        obs = self.tools.call(action, arguments)
        return StepRecord(step, thought, action, arguments, obs, (time.time() - t0) * 1000)

    def _error_result(self, run_id: str, t0: float, steps: list[StepRecord], message: str) -> dict:
        return {
            "id": run_id,
            "status": "error",
            "error": message,
            "tools_used": sorted({s.action for s in steps}),
            "steps": [asdict(s) for s in steps],
            "timings": {
                "total_ms": round((time.time() - t0) * 1000, 2),
                "sla_ms": SLA_MS,
            },
        }


