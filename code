async def self_check() -> list[str]:
    notes: list[str] = []
    agent = RecruitingAgent()
    assert len(agent.tool_schemas()) >= 2

    # Parse accuracy
    sample = INTERNAL_CANDIDATES[0]["resume_text"]
    parsed = parse_resume_text(sample)
    assert "python" in parsed["skills"]
    assert parsed["years_experience"] >= 4
    assert "Maya" in parsed["name"]
    notes.append(f"parse name={parsed['name']} skills={parsed['skills'][:4]}")

    # Evaluate internal candidate for backend
    r1 = await agent.evaluate(candidate_id="cand_001", job_id="backend_engineer")
    assert r1["status"] == "complete"
    assert r1["scores"]["overall"] >= 70
    assert r1["recommendation"] in ("advance", "consider", "pass")
    assert r1["reasoning"]
    assert len(r1["tools_used"]) >= 2
    blob = json.dumps(r1)
    assert not re.search(r"(?i)ai[- ]generated|powered by ai|as an ai", blob)
    notes.append(
        f"maya backend overall={r1['scores']['overall']} rec={r1['recommendation']} tools={r1['tools_used']}"
    )

    # Multiple roles
    r2 = await agent.evaluate(candidate_id="cand_002", job_id="frontend_engineer")
    assert r2["recommendation"] in ("advance", "consider")
    r3 = await agent.evaluate(candidate_id="cand_002", job_id="backend_engineer")
    assert r3["scores"]["overall"] < r2["scores"]["overall"]
    notes.append(f"jordan frontend={r2['scores']['overall']} backend={r3['scores']['overall']}")

    # Raw resume path
    r4 = await agent.evaluate(
        resume_text=INTERNAL_CANDIDATES[3]["resume_text"],
        job_id="devops_engineer",
    )
    assert r4["status"] == "complete"
    assert r4["scores"]["overall"] >= 75
    notes.append(f"riley devops overall={r4['scores']['overall']}")

    # Rank
    ranked = await agent.rank_for_job("data_analyst", limit=3)
    assert ranked["status"] == "complete"
    assert len(ranked["candidates"]) >= 1
    assert ranked["candidates"][0]["scores"]["overall"] >= ranked["candidates"][-1]["scores"]["overall"]
    notes.append(
        "rank data_analyst: "
        + ", ".join(f"{c['name']}={c['scores']['overall']}" for c in ranked["candidates"])
    )

    # Structured JSON keys
    for key in (
        "candidate",
        "job",
        "scores",
        "recommendation",
        "reasoning",
        "next_actions",
        "summary",
    ):
        assert key in r1

    return notes


