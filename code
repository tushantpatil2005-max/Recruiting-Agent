        "numpy",
    }
)


def parse_resume_text(text: str) -> dict:
    raw = text.strip()
    lines = [ln.strip() for ln in raw.splitlines() if ln.strip()]

    email_m = re.search(r"[\w.+-]+@[\w.-]+\.\w+", raw)
    email = email_m.group(0) if email_m else ""

    # Name: first non-empty line that is not email/phone/header keyword
    name = ""
    for ln in lines[:5]:
        if email and email in ln:
            continue
        if re.search(r"^(experience|education|skills|email|phone|resume)\b", ln, re.I):
            continue
        if re.search(r"\d{3}[-.\s]?\d{3}", ln):
            continue
        if 2 <= len(ln.split()) <= 5 and not re.search(r"@|http", ln):
            name = ln
            break
    if not name and lines:
        name = lines[0]

    # Skills: line after "Skills" or vocab hits
    skills_found: list[str] = []
    skills_block = ""
    for i, ln in enumerate(lines):
        if re.match(r"^skills\b", ln, re.I):
            skills_block = ln.split(":", 1)[-1] + " " + " ".join(lines[i + 1 : i + 3])
            break
    hay = (skills_block or raw).lower()
    for skill in SKILL_VOCAB:
        if re.search(rf"(?<![a-z]){re.escape(skill)}(?![a-z])", hay):
            skills_found.append(skill)
    # preserve order, unique
    seen = set()
    skills = []
    for s in skills_found:
        if s not in seen:
            seen.add(s)
            skills.append(s)

    education = ""
    for i, ln in enumerate(lines):
        if re.match(r"^education\b", ln, re.I):
            education = ln.split(":", 1)[-1].strip()
            if not education and i + 1 < len(lines):
                education = lines[i + 1]
            break
    if not education:
        for ln in lines:
            if re.search(r"\b(b\.?s\.?|m\.?s\.?|bachelor|master|ph\.?d|bootcamp)\b", ln, re.I):
                education = ln
                break

    titles: list[str] = []
    for ln in lines:
        if re.search(
            r"\b(engineer|developer|analyst|manager|designer|sre|intern)\b", ln, re.I
        ):
            # skip pure skill lines
            if re.match(r"^skills\b", ln, re.I):
                continue
            if len(ln) < 80:
                titles.append(re.sub(r"\s{2,}", " ", ln)[:80])
    titles = titles[:5]

    years = years_from_text(raw)

    return {
        "name": name or "Unknown",
        "email": email,
        "skills": skills,
        "years_experience": years,
        "education": education,
        "titles": titles,
        "raw_length": len(raw),
    }


